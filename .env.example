DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/mail/oauth/callback/
PUBLIC_API_BASE_URL=http://localhost:8000
GMAIL_TOKEN_ENCRYPTION_KEY=
MAIL_APP_URL=http://localhost:3000

# SMTP credentials are required to email client mailbox invitations.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=replace-with-provider-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL="MONATA <notifications@example.com>"

# Percentage of completed VA tasks and requests added to the manager's QA queue.
VA_QA_SAMPLE_PERCENT=10
